# .env는 자동 로드되지 않습니다. IDE 또는 실행 환경에 설정합니다.
DB_URL=jdbc:mysql://localhost:3306/investlab_core?connectionTimeZone=UTC
DB_USERNAME=investlab_core
DB_PASSWORD=
JWT_SECRET_BASE64=
JWT_ISSUER=investlab
JWT_AUDIENCE=investlab-api
AI_BASE_URL=http://localhost:8000
# JWT_SECRET_BASE64는 32바이트 이상 난수를 Base64 인코딩합니다. 실제 값은 Git에 넣지 않습니다.
